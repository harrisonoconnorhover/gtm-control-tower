# Optional live-connector configuration. The portfolio demo runs without these.
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=67.0
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
N8N_WEBHOOK_URL=
N8N_STATE_WEBHOOK_URL=
N8N_REPAIR_WEBHOOK_URL=
N8N_FUNKY_WEBHOOK_URL=
N8N_HUBSPOT_SYNC_WEBHOOK_URL=
N8N_HUBSPOT_SOURCE_WEBHOOK_URL=
N8N_GOOGLE_SHEETS_READ_WEBHOOK_URL=
N8N_GOOGLE_SHEETS_WRITE_WEBHOOK_URL=
# Docker webhook example: http://n8n:5678/webhook/gtm-control-tower-sheets-read
# Node webhook example: http://localhost:5678/webhook/gtm-control-tower-sheets-read
# SQLite-backed saved workspaces are enabled by default in Docker and local development.
CONTROL_TOWER_PERSISTENCE_ENABLED=true
# Required in production. Authorized users enter this key in the CSV sync panel.
CONTROL_TOWER_SYNC_KEY=
# Direct comparison and writes require crm.objects.contacts.read and crm.objects.contacts.write.
# Leave blank when using the n8n OAuth workflow instead. Never commit the real value.
HUBSPOT_ACCESS_TOKEN=
# Optional unattended Monitor runner; the app server keeps CRM credentials.
# Enable checks and choose repair policy in /app/monitor before starting it.
CONTROL_TOWER_MONITOR_URL=http://127.0.0.1:3000
# Node infers configured providers when omitted. Docker defaults to HubSpot;
# set this to salesforce or hubspot,salesforce to monitor Salesforce in Docker.
# CONTROL_TOWER_MONITOR_PROVIDERS=hubspot,salesforce
# Optional Slack alerts. The incoming webhook determines the destination channel.
# Keep this secret on the app server; never put it in browser variables or Git.
CONTROL_TOWER_SLACK_WEBHOOK_URL=
# Reachable private Control Tower origin used in Slack links, e.g. https://tower.example.com
CONTROL_TOWER_APP_URL=
# Optional evidence-only investigator credential, distinct from the operator key.
CONTROL_TOWER_INVESTIGATOR_KEY=
# Optional model explanation, used only when explicitly requested in the incident UI.
# No default model and no automatic paid model calls. Choose a Responses-compatible model.
OPENAI_API_KEY=
CONTROL_TOWER_INVESTIGATION_MODEL=
# Optional native HubSpot change intake (app subscriptions must be configured separately).
HUBSPOT_MONITOR_CLIENT_SECRET=
HUBSPOT_MONITOR_PORTAL_ID=
HUBSPOT_MONITOR_WEBHOOK_URL=
# Optional native Salesforce CDC subscriber/receiver. Use the same >=32 character secret.
SALESFORCE_MONITOR_ORG_ID=
CONTROL_TOWER_CDC_RELAY_SECRET=
CONTROL_TOWER_CDC_RELAY_URL=http://127.0.0.1:3000/api/control-tower/events/salesforce
SALESFORCE_CDC_CHANNEL=/data/ChangeEvents
SALESFORCE_CDC_CHECKPOINT_PATH=.runtime/salesforce-cdc/checkpoint.json
GOOGLE_CLOUD_PROJECT=
BIGQUERY_SOURCE_DATASET=gtm_control_tower
DBT_BIGQUERY_DATASET=gtm_control_tower_dbt
GOOGLE_APPLICATION_CREDENTIALS=
DBT_BIGQUERY_METHOD=service-account
GENERIC_TIMEZONE=UTC
