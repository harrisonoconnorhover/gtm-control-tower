# Optional live-connector configuration. The portfolio demo runs without these.
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/gtm-lead
N8N_STATE_WEBHOOK_URL=http://localhost:5678/webhook/gtm-control-tower-state
N8N_REPAIR_WEBHOOK_URL=http://localhost:5678/webhook/gtm-control-tower-repair
N8N_FUNKY_WEBHOOK_URL=http://localhost:5678/webhook/gtm-control-tower-seed-funky
N8N_HUBSPOT_SYNC_WEBHOOK_URL=http://localhost:5678/webhook/gtm-control-tower-hubspot-sync
# Required in production. Authorized users enter this key in the CSV sync panel.
CONTROL_TOWER_SYNC_KEY=
# Easiest single-portal setup: HubSpot private app token with crm.objects.contacts.write.
# Leave blank when using the n8n OAuth workflow instead. Never commit the real value.
HUBSPOT_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=harrison-gtm-control-tower
BIGQUERY_DATASET=gtm_control_tower
GOOGLE_APPLICATION_CREDENTIALS=
DBT_BIGQUERY_METHOD=service-account
