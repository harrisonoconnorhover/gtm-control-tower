{
  "name": "gtm-control-tower",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted GTM systems lab for repairing messy CRM data, routing leads, and modeling revenue operations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrisonoconnorhover/gtm-control-tower.git"
  },
  "homepage": "https://gtm-control-tower.pages.dev/",
  "bugs": {
    "url": "https://github.com/harrisonoconnorhover/gtm-control-tower/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:public": "vite build --config vite.public.config.ts",
    "start": "vinext start",
    "preview:public": "vite --config vite.public.config.ts --host 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-public --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser-csv": "node scripts/check-browser-csv.mjs",
    "test:csv-mapping": "node scripts/check-csv-mapping.mjs",
    "test:operator-key": "node scripts/check-operator-key.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "monitor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/monitor.mjs",
    "test:monitor-ui": "node scripts/check-monitor.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit": "npm audit --audit-level=high",
    "generate:public-fixture": "node scripts/generate_public_company_fixture.mjs",
    "generate:walkthrough": "bash scripts/generate-walkthrough-video.sh",
    "smoke:fresh-install": "bash scripts/fresh-install-smoke.sh",
    "generate:data": "python3 scripts/generate_synthetic_crm.py",
    "seed:duplicate-audit": "node --env-file-if-exists=.env.local scripts/seed_duplicate_audit.mjs",
    "configure:salesforce": "node scripts/configure_salesforce_env.mjs",
    "sync:n8n": "node scripts/sync_ops_workflow.mjs",
    "test:crm-batches": "node scripts/check-crm-batches.mjs",
    "test:receipt-recovery": "node scripts/check-receipt-recovery.mjs",
    "test:import-holds": "node scripts/check-import-holds.mjs",
    "test:import-controls": "node scripts/check-import-controls.mjs",
    "test:confirmed-matches": "node scripts/check-import-match-decision.mjs",
    "test:run-verification": "node scripts/check-run-verification.mjs",
    "test:pomade-handoff": "node scripts/check-pomade-handoff.mjs",
    "test:pomade-qualification": "node scripts/check-pomade-qualification.mjs",
    "test:crm-cohort-roundtrip": "node scripts/check-crm-cohort-roundtrip.mjs",
    "test:safe-import": "node scripts/check-safe-import.mjs",
    "test:operations-inbox-ui": "node scripts/check-operations-inbox.mjs",
    "test:slack-ui": "node scripts/check-slack-notifications.mjs",
    "generate:messy-crm": "node scripts/generate-messy-crm.mjs",
    "test:incidents-ui": "node scripts/check-incidents.mjs",
    "qualify:incidents": "node scripts/qualify-incident-stress.mjs",
    "qualify:incidents:native": "node --env-file-if-exists=.env.local scripts/qualify-incidents-native.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.13.15",
    "next": "16.3.8",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261006.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fast-glob": "file:./vendor/fast-glob-compat",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "vite-plugin-dynamic-import": {
      "fast-glob": "$fast-glob"
    }
  }
}
