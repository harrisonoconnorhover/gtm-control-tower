// Used by db:migrate:local. Keep this binding and placeholder ID aligned with
// vite.config.ts; the npm command explicitly targets local persistence.
{
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
